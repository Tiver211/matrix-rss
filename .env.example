# --- Matrix account of the bot ---
MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_USER_ID=@rssbot:example.org
MATRIX_PASSWORD=change-me
# Encrypts the end-to-end keys in the database (min. 16 chars). Do not change it after the first start.
MATRIX_PICKLE_KEY=change-me-to-a-long-random-string
# Comma-separated bot admins: they may invite the bot, publish rooms and manage all tokens and keys.
MATRIX_ADMINS=@you:example.org
# Members of a room with at least this power level (100 = admin, 50 = moderator) may issue and revoke
# the feed tokens and API keys of that room, and only of it. 0 = only MATRIX_ADMINS may.
MATRIX_ROOM_ADMIN_LEVEL=100
MATRIX_COMMAND_PREFIX=!rss
MATRIX_DEVICE_NAME=matrixrss

# --- HTTP server ---
HTTP_ADDR=:8080
# Address under which the feeds are reachable from outside; used in the links the bot posts.
PUBLIC_BASE_URL=https://rss.example.org
# Root bearer token (min. 16 chars), e.g. `openssl rand -hex 32`. It can use the whole API, including the
# admin endpoints that create and revoke API keys and feed tokens. Hand out API keys instead of this token.
API_TOKEN=change-me-to-a-long-random-string

# --- Database ---
# sqlite: DSN is a file path. postgres: DSN is a URL such as
# postgres://user:password@localhost:5432/matrixrss?sslmode=disable
DATABASE_DRIVER=sqlite
DATABASE_DSN=data/matrixrss.db

# --- Messages ---
# Stored messages older than this are deleted hourly; 0 keeps everything.
# The API fetches older messages from Matrix again when they are requested.
MESSAGE_RETENTION=720h
# true: keep the text of messages that were deleted in the room (readable with deleted=include|only).
# false: keep only who deleted a message, when and why; the text is erased.
MESSAGE_KEEP_DELETED=false
# Largest attachment (bytes) the bot serves to readers; 0 turns file downloads off. Files are fetched from
# the homeserver on request (and decrypted for encrypted rooms), never stored by the bot.
MEDIA_MAX_SIZE=52428800
# Let the API fetch messages missing from the database from the Matrix homeserver.
HISTORY_BACKFILL=true

# --- Misc ---
# debug | info | warn | error
LOG_LEVEL=info
